{
  "name": "dsh-plugin-image-studio",
  "version": "0.1.0",
  "description": "DSH 生图 / 视频工作台插件：可配置任意 OpenAI 兼容或 Gemini 生图接口，支持文生图、参考图编辑与局部重绘，附带视频画布（Seedance）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "text-to-image",
    "inpaint",
    "openai-images",
    "1route"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbycwzm001/dsh-plugin-image-studio.git"
  },
  "homepage": "https://github.com/hbycwzm001/dsh-plugin-image-studio#readme",
  "bugs": {
    "url": "https://github.com/hbycwzm001/dsh-plugin-image-studio/issues"
  }
}
